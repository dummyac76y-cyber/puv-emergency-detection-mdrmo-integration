# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For database seeding (server-side only, never expose in client)
# Get this from Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional: Supabase CLI local development
# SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres